# Frontend / public URL for current environment
FRONTEND_URL=https://pbthub.ru
SESSION_SECRET=change-me-session-secret
SESSION_COOKIE_NAME=pbth.sid
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=lax
DEV_AUTH_ENABLED=0
DEV_AUTH_SECRET=

# Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pbth
DB_USER=pbth
DB_PASSWORD=pbth
DB_SSL=0

# Telegram OAuth
TELEGRAM_BOT_TOKEN=change-me-telegram-bot-token
TELEGRAM_BOT_USERNAME=pbthub_bot
VITE_TELEGRAM_BOT_USERNAME=pbthub_bot
TELEGRAM_CALLBACK_URL=https://pbthub.ru/api/v1/auth/telegram/callback
TELEGRAM_MAX_AUTH_AGE_SEC=600
# Optional Bot API relay (set when host network blocks api.telegram.org).
# Relay must accept Bot API path layout: <base>/bot<token>/<method>.
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
ADMIN_ROLE_ALLOWLIST_USERNAMES=
ADMIN_ROLE_ALLOWLIST_IDS=

# Yandex OAuth (secondary login provider). Disabled by default; flip to 1
# on staging/prod after registering the app at https://oauth.yandex.ru/.
AUTH_YANDEX_ENABLED=0
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_REDIRECT_URI=https://pbthub.ru/api/v1/auth/yandex/callback
YANDEX_OAUTH_LINK_REDIRECT_URI=https://pbthub.ru/api/v1/auth/yandex/link/callback
VITE_AUTH_YANDEX_ENABLED=0

# Telegram OIDC (Auth v2)
AUTH_OIDC_ENABLED=0
AUTH_OIDC_FALLBACK_ENABLED=1
AUTH_OIDC_ADMIN_REQUIRED=0
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
TELEGRAM_OIDC_JWKS_URL=https://oauth.telegram.org/.well-known/jwks.json
TELEGRAM_OIDC_AUTHORIZE_URL=https://oauth.telegram.org/auth
TELEGRAM_OIDC_TOKEN_URL=https://oauth.telegram.org/token
AUTH_OIDC_STATE_TTL_SEC=600
AUTH_OIDC_CLOCK_SKEW_SEC=60

# ICS
ICS_TOKEN_SECRET=change-me-ics-secret
APP_TIME_ZONE=Europe/Moscow
ICS_RECURRING_WINDOW_DAYS=45

# Rate limits
RATE_AUTH_WINDOW_MS=60000
RATE_AUTH_MAX=20
RATE_WRITE_WINDOW_MS=60000
RATE_WRITE_MAX=120

# Notifications queue (pg-boss)
NOTIFICATIONS_QUEUE_ENABLED=0
NOTIFICATIONS_QUEUE_CONCURRENCY=5
NOTIFICATIONS_QUEUE_RETRY_LIMIT=4
NOTIFICATIONS_QUEUE_RETRY_DELAY_SECONDS=20

# Release metadata (injected during deploy)
RELEASE_ID=dev
RELEASE_COMMIT=unknown
RELEASE_BUILT_AT=unknown

# Bind ports (used by release compose profiles)
BACKEND_BIND_PORT=8100
FRONTEND_BIND_PORT=3100
