# Frontend / public URL for current environment
FRONTEND_URL=https://pbthub.ru
SESSION_SECRET=change-me-session-secret
SESSION_COOKIE_NAME=pbth.sid
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=lax
DEV_AUTH_ENABLED=0
DEV_AUTH_SECRET=

# Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pbth
DB_USER=pbth
DB_PASSWORD=pbth
DB_SSL=0

# Telegram OAuth
TELEGRAM_BOT_TOKEN=change-me-telegram-bot-token
TELEGRAM_BOT_USERNAME=pbthub_bot
VITE_TELEGRAM_BOT_USERNAME=pbthub_bot
TELEGRAM_CALLBACK_URL=https://pbthub.ru/api/v1/auth/telegram/callback
TELEGRAM_MAX_AUTH_AGE_SEC=86400
ADMIN_ROLE_ALLOWLIST_USERNAMES=
ADMIN_ROLE_ALLOWLIST_IDS=

# ICS
ICS_TOKEN_SECRET=change-me-ics-secret
APP_TIME_ZONE=Europe/Moscow
ICS_RECURRING_WINDOW_DAYS=45

# Rate limits
RATE_AUTH_WINDOW_MS=60000
RATE_AUTH_MAX=20
RATE_WRITE_WINDOW_MS=60000
RATE_WRITE_MAX=120

# Notifications queue (pg-boss)
NOTIFICATIONS_QUEUE_ENABLED=0
NOTIFICATIONS_QUEUE_CONCURRENCY=5
NOTIFICATIONS_QUEUE_RETRY_LIMIT=4
NOTIFICATIONS_QUEUE_RETRY_DELAY_SECONDS=20

# Release metadata (injected during deploy)
RELEASE_ID=dev
RELEASE_COMMIT=unknown
RELEASE_BUILT_AT=unknown

# Bind ports (used by release compose profiles)
BACKEND_BIND_PORT=8100
FRONTEND_BIND_PORT=3100
