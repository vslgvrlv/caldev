upstream pbth_prod_frontend {
    server 127.0.0.1:3100;
}

upstream pbth_prod_backend {
    server 127.0.0.1:8100;
}

upstream pbth_staging_frontend {
    server 127.0.0.1:3200;
}

upstream pbth_staging_backend {
    server 127.0.0.1:8200;
}

server {
    listen 80;
    server_name pbthub.ru www.pbthub.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 80;
    server_name staging.pbthub.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name pbthub.ru www.pbthub.ru;

    # ssl_certificate /etc/letsencrypt/live/pbthub.ru/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/pbthub.ru/privkey.pem;

    location /api/ {
        proxy_pass http://pbth_prod_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /calendar/ {
        proxy_pass http://pbth_prod_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Скорость (personal-os#1431). Ответы API и календаря контейнер отдаёт
    # без сжатия — жмёт nginx. JS и CSS фронта vite preview сжимает сам,
    # повторно nginx их не трогает.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/javascript text/css text/calendar image/svg+xml application/manifest+json;

    # Файлы с хэшем в имени не меняются никогда: кэш на год, без перепроверки.
    # add_header без always: 404 на старое имя не попадёт в кэш.
    # index.html, sw.js и manifest остаются no-cache — иначе PWA не узнает о выкате.
    location /assets/ {
        proxy_pass http://pbth_prod_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Иконки без хэша в имени — сутки.
    location /icons/ {
        proxy_pass http://pbth_prod_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=86400";
    }

    location / {
        proxy_pass http://pbth_prod_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 443 ssl http2;
    server_name staging.pbthub.ru;

    # ssl_certificate /etc/letsencrypt/live/staging.pbthub.ru/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/staging.pbthub.ru/privkey.pem;

    location /api/ {
        proxy_pass http://pbth_staging_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /calendar/ {
        proxy_pass http://pbth_staging_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Скорость (personal-os#1431). Ответы API и календаря контейнер отдаёт
    # без сжатия — жмёт nginx. JS и CSS фронта vite preview сжимает сам,
    # повторно nginx их не трогает.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/javascript text/css text/calendar image/svg+xml application/manifest+json;

    # Файлы с хэшем в имени не меняются никогда: кэш на год, без перепроверки.
    # add_header без always: 404 на старое имя не попадёт в кэш.
    # index.html, sw.js и manifest остаются no-cache — иначе PWA не узнает о выкате.
    location /assets/ {
        proxy_pass http://pbth_staging_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Иконки без хэша в имени — сутки.
    location /icons/ {
        proxy_pass http://pbth_staging_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=86400";
    }

    location / {
        proxy_pass http://pbth_staging_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
