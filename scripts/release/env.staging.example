# Domain
FRONTEND_URL=https://staging.pbthub.ru
TELEGRAM_CALLBACK_URL=https://staging.pbthub.ru/api/v1/auth/telegram/callback

# App release metadata (filled by deploy script)
RELEASE_ID=manual
RELEASE_COMMIT=unknown
RELEASE_BUILT_AT=unknown

# Ports (nginx upstream)
BACKEND_BIND_PORT=8200
FRONTEND_BIND_PORT=3200

# DB (staging isolated)
DB_NAME=pbth_staging
DB_USER=pbth
DB_PASSWORD=change-me
DB_SSL=0

# Secrets
SESSION_SECRET=change-me-session-secret
ICS_TOKEN_SECRET=change-me-ics-secret
TELEGRAM_BOT_TOKEN=change-me-telegram-bot-token
TELEGRAM_BOT_USERNAME=pbthub_bot
VITE_TELEGRAM_BOT_USERNAME=pbthub_bot

# Optional
SESSION_COOKIE_NAME=pbth.stg.sid
SESSION_COOKIE_SAMESITE=lax
APP_TIME_ZONE=Europe/Moscow
ICS_RECURRING_WINDOW_DAYS=45
RATE_AUTH_WINDOW_MS=60000
RATE_AUTH_MAX=20
RATE_WRITE_WINDOW_MS=60000
RATE_WRITE_MAX=120
NOTIFICATIONS_QUEUE_ENABLED=0

# Telegram OIDC (Auth v2)
AUTH_OIDC_ENABLED=0
AUTH_OIDC_FALLBACK_ENABLED=1
AUTH_OIDC_ADMIN_REQUIRED=0
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://staging.pbthub.ru/api/v1/auth/telegram/oidc/callback
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
TELEGRAM_OIDC_JWKS_URL=https://oauth.telegram.org/.well-known/jwks.json
TELEGRAM_OIDC_AUTHORIZE_URL=https://oauth.telegram.org/auth
TELEGRAM_OIDC_TOKEN_URL=https://oauth.telegram.org/token
AUTH_OIDC_STATE_TTL_SEC=600
AUTH_OIDC_CLOCK_SKEW_SEC=60
