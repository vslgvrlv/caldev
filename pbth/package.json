{
  "name": "paintball-hub",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run __tests__/unit",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "gen:api-types": "openapi-typescript http://127.0.0.1:8000/api/v1/openapi.json -o generated/openapi.d.ts"
  },
  "dependencies": {
    "date-fns": "^2.30.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.5.0",
    "openapi-typescript": "^7.5.2",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^4.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8"
  }
}
